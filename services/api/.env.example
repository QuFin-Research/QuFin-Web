# Copy to .env for local development. Never commit .env.
# Every setting is read from the environment with the QUFIN_ prefix.

# development | staging | production (production hides /docs and /openapi.json)
QUFIN_ENVIRONMENT=development

# Comma-separated list of browser origins allowed to call the API
QUFIN_CORS_ORIGINS=http://localhost:3000

# SQLAlchemy URL for the decision journal. SQLite for now; Postgres 16 later,
# e.g. postgresql+psycopg://user:password@host:5432/qufin
QUFIN_DATABASE_URL=sqlite:///./qufin.db

# Sign-in sessions (httpOnly cookie holding an opaque token; only its hash is stored)
QUFIN_SESSION_TTL_HOURS=168
# Must be true when served over HTTPS; the API refuses to start in production otherwise
QUFIN_COOKIE_SECURE=false
# Parent domain when the web app and API are on sibling subdomains, e.g. qufin.ai
# QUFIN_COOKIE_DOMAIN=

# Sign-in/sign-up attempts allowed per IP and per email in each window
QUFIN_AUTH_RATE_LIMIT=10
QUFIN_AUTH_RATE_WINDOW_SECONDS=900

# Apply database migrations on startup (set false where deploys run `alembic upgrade head`)
QUFIN_AUTO_MIGRATE=true

# FRED/ALFRED API key for macro ingestion (free): https://fred.stlouisfed.org/docs/api/api_key.html
# QUFIN_FRED_API_KEY=

# Raw zone: every fetched payload is kept as received under this folder (relative to
# services/api). Unset disables it.
QUFIN_RAW_DIR=../../data/raw
