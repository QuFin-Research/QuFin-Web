# Copy to .env for local development. Never commit .env.
# Every setting is read from the environment with the QUFIN_ prefix.

# development | staging | production (production hides /docs and /openapi.json)
QUFIN_ENVIRONMENT=development

# Comma-separated list of browser origins allowed to call the API
QUFIN_CORS_ORIGINS=http://localhost:3000

# SQLAlchemy URL for the decision journal. SQLite for now; Postgres 16 later,
# e.g. postgresql+psycopg://user:password@host:5432/qufin
QUFIN_DATABASE_URL=sqlite:///./qufin.db
